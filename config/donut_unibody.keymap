#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        boot {
            bindings = <&bootloader>;
            key-positions = <51 50 49>;
        };

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <35 36>;
        };

        Entf {
            bindings = <&kp DELETE>;
            key-positions = <12 13>;
        };
    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 11 12 13 14 15 22 23 24 25 26 34 35 36 37 10 27 38 45 44 46 47 48 49>;
            require-prior-idle-ms = <150>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <32 33 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 39 40 41 42 43 50 51 52 53 54 55>;
            require-prior-idle-ms = <150>;
        };

        strg_dance: strg_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "STRG_DANCE";
            #binding-cells = <0>;
            bindings = <&kp LCTRL>, <&mo 0>;

            tapping-term-ms = <350>;
        };

        shift_dance: shift_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "SHIFT_DANCE";
            #binding-cells = <0>;
            bindings = <&kp RSHFT>, <&kp CAPSLOCK>;
        };

        hml2: hml2 {
            compatible = "zmk,behavior-hold-tap";
            label = "HML2";
            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 39 40 41 42 43 50 51 52 53 54 55>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        hml_mo_lay: hml_mo_lay {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_MO_LAY";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <32 33 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 9 16 17 18 19 20 21 28 29 30 31 32 33 39 40 41 42 43 50 51 52 53 54 55>;
            require-prior-idle-ms = <150>;
        };

        TopRightDance: TopRightDance {
            compatible = "zmk,behavior-tap-dance";
            label = "TOPRIGHTDANCE";
            #binding-cells = <0>;
            bindings = <&none>, <&kp K_COFFEE>;
        };

        windows_desktop_tap_dance: windows_desktop_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "WINDOWS_DESKTOP_TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&windows_desktop_right>, <&windows_desktop_left>;
        };
    };

    macros {
        windows_desktop_left: windows_virtual_desktop_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN &kp LCTRL &kp LEFT>;
            label = "WINDOWS_VIRTUAL_DESKTOP_LEFT";
        };

        windows_desktop_right: windows_desktop_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LEFT_WIN &kp LCTRL &kp RIGHT>;
            label = "WINDOWS_DESKTOP_RIGHT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                   &kp NUMBER_1                &kp NUMBER_2     &kp NUMBER_3      &kp NUMBER_4      &kp NUMBER_5  &kp NUMBER_6     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9      &kp NUMBER_0
&hml_mo_lay 4 ESC  &kp X                       &kp V            &kp L             &kp C             &kp W         &kp K            &kp H         &kp G         &kp F             &kp Q             &kp MINUS
&hml_mo_lay 3 TAB  &hml LEFT_GUI U             &hml LEFT_ALT I  &kp A             &kp E             &kp O         &kp S            &kp N         &kp R         &hmr RIGHT_ALT T  &hmr RIGHT_GUI D  &kp Z
                   &kp LEFT_BRACKET            &kp SEMICOLON    &kp SINGLE_QUOTE  &kp P             &kp Y         &kp B            &kp M         &kp COMMA     &kp PERIOD        &kp J
&kp PRINTSCREEN    &windows_desktop_tap_dance  &mo 2            &kp LEFT_ALT      &kp LEFT_CONTROL  &kp SPACE     &kp RIGHT_SHIFT  &sl 1         &kp ENTER     &none             &kp LEFT_SHIFT    &TopRightDance
            >;
        };

        symbol_layer {
            bindings = <
            &kp F1             &kp F2         &kp F3        &kp F4        &kp F5         &kp F6            &kp F7             &kp F8        &kp F9        &kp F10
&none       &kp RIGHT_BRACKET  &kp LS(SLASH)  &kp RA(N8)    &kp RA(N9)    &kp GRAVE      &kp LS(NUMBER_1)  &kp NUBS           &kp LS(NUBS)  &kp LS(N0)    &kp LS(N6)     &none
&kp DELETE  &kp RA(MINUS)      &kp LS(N7)     &kp RA(N7)    &kp RA(N0)    &kp RS(RBRC)   &kp LS(MINUS)     &kp LS(N8)         &kp LS(N9)    &kp SLASH     &kp LS(DOT)    &kp RA(Q)
            &kp NUHS           &kp LS(N4)     &kp RA(NUBS)  &kp RA(RBRC)  &kp LS(EQUAL)  &kp LS(N5)        &kp RIGHT_BRACKET  &kp LS(N2)    &kp LS(NUHS)  &kp LS(COMMA)
&none       &none              &none          &trans        &to 0         &to 0          &none             &sl 2              &sl 0         &none         &none          &none
            >;
        };

        number_and_arrow {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans  &trans
            >;
        };

        arrow_layer {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp END       &kp PAGE_UP  &kp PAGE_DOWN  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp UP_ARROW  &kp DOWN     &kp RIGHT      &trans
        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans       &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans        &trans       &trans         &trans
            >;
        };

        Navigation_Layer {
            bindings = <
        &bt BT_SEL 3  &trans  &trans  &trans  &bt BT_CLR  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 2  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 1  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
        &bt BT_SEL 0  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
