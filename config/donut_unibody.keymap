#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10

/ {
    combos {
        compatible = "zmk,combos";

        boot {
            bindings = <&bootloader>;
            key-positions = <51 50 49>;
        };

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <35 36>;
        };

        Entf {
            bindings = <&kp DELETE>;
            key-positions = <12 13>;
        };

        BT0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <2 3>;
        };

        sz_combi {
            bindings = <&kp MINUS>;
            key-positions = <19 20>;
        };

        EnterCombi {
            bindings = <&kp ENTER>;
            key-positions = <41 42>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <14 15>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <26 27>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <37 38>;
        };
    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <0 1 2 3 4 11 12 13 14 15 22 23 24 25 26 34 35 36 37 10 27 38 45 44 46 47 48 49>;
            require-prior-idle-ms = <150>;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <32 33 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 39 40 41 42 43 50 51 52 53 54 55>;
            require-prior-idle-ms = <150>;
        };

        hml_mo_lay: hml_mo_lay {
            compatible = "zmk,behavior-hold-tap";
            label = "HML_MO_LAY";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <350>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <32 33 5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 9 16 17 18 19 20 21 28 29 30 31 32 33 39 40 41 42 43 50 51 52 53 54 55>;
            require-prior-idle-ms = <150>;
        };

        TopRightDance: TopRightDance {
            compatible = "zmk,behavior-tap-dance";
            label = "TOPRIGHTDANCE";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_SEL 1>;
        };

        windows_desktop_tap_dance: windows_desktop_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "WINDOWS_DESKTOP_TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&windows_desktop_right>, <&windows_desktop_left>;
        };

        Tab_arrow: Tab_arrow {
            compatible = "zmk,behavior-hold-tap";
            label = "TAB_ARROW";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <300>;
        };

        Tap_Layer: Tap_Layer {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_LAYER";
            #binding-cells = <2>;
            tapping-term-ms = <300>;
            flavor = "tap-preferred";
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        windows_desktop_left: windows_virtual_desktop_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN &kp LCTRL>,
                <&macro_tap>,
                <&kp LEFT>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LCTRL>;

            label = "WINDOWS_VIRTUAL_DESKTOP_LEFT";
        };

        windows_desktop_right: windows_desktop_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_WIN &kp LCTRL>,
                <&macro_tap>,
                <&kp RIGHT>,
                <&macro_release>,
                <&kp LEFT_WIN &kp LCTRL>;

            label = "WINDOWS_DESKTOP_RIGHT";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
                   &none                       &none            &none                &none               &none      &none                   &none                &none                 &none             &none
&none              &kp X                       &kp V            &kp L                &kp C               &kp W      &kp K                   &kp H                &kp G                 &kp F             &kp Q             &none
&hml_mo_lay 3 ESC  &hml LEFT_GUI U             &hml LEFT_ALT I  &hml A LEFT_CONTROL  &hml E LEFT_SHIFT   &kp O      &kp S                   &hmr N RIGHT_SHIFT   &hmr R RIGHT_CONTROL  &hmr RIGHT_ALT T  &hmr RIGHT_GUI D  &kp Z
                   &kp LEFT_BRACKET            &kp SEMICOLON    &kp SINGLE_QUOTE     &kp P               &kp Y      &kp B                   &kp M                &kp COMMA             &kp PERIOD        &kp J
&kp PRINTSCREEN    &windows_desktop_tap_dance  &none            &Tap_Layer 2 TAB     &Tap_Layer 3 ENTER  &kp SPACE  &Tap_Layer 2 BACKSPACE  &Tap_Layer 1 DELETE  &mo 3                 &none             &kp LG(L)    &TopRightDance
            >;
        };

        symbol_layer {
            bindings = <
            &none              &none          &none         &none         &none          &none             &none              &none         &none         &none
&none       &kp RIGHT_BRACKET  &kp LS(SLASH)  &kp RA(N8)    &kp RA(N9)    &kp GRAVE      &kp LS(NUMBER_1)  &kp NUBS           &kp LS(NUBS)  &kp LS(N0)    &kp LS(N6)     &none
&kp DELETE  &kp RA(MINUS)      &kp LS(N7)     &kp RA(N7)    &kp RA(N0)    &kp RS(RBRC)   &kp LS(MINUS)     &kp LS(N8)         &kp LS(N9)    &kp SLASH     &kp LS(DOT)    &kp RA(Q)
            &kp NUHS           &kp LS(N4)     &kp RA(NUBS)  &kp RA(RBRC)  &kp LS(EQUAL)  &kp LS(N5)        &kp RIGHT_BRACKET  &kp LS(N2)    &kp LS(NUHS)  &kp LS(COMMA)
&none       &none              &none          &trans        &to 0         &to 0          &to 1             &mo 2              &sl 0         &none         &to 3          &none
            >;
        };

        number {
            bindings = <
        &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans  &trans
        &trans  &trans  &trans  &trans  &trans  &kp NUMBER_0  &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &trans
&trans  &trans  &trans  &trans  &trans  &to 0   &to 2         &trans        &trans        &trans        &trans  &trans
            >;
        };

        arrow_layer {
            bindings = <
        &trans  &trans          &mkp MCLK       &trans           &trans          &trans        &trans      &trans        &trans       &trans
&trans  &trans  &trans          &mmv MOVE_UP    &mkp LCLK        &mkp RCLK       &kp C_MUTE    &kp HOME    &kp END       &kp PAGE_UP  &kp PAGE_DOWN  &trans
&trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_UP    &kp C_VOL_UP  &kp LEFT    &kp UP_ARROW  &kp DOWN     &kp RIGHT      &trans
        &trans  &trans          &trans          &trans           &msc SCRL_DOWN  &kp C_VOL_DN  &kp C_PP    &kp C_PREV    &kp C_NEXT   &trans
&trans  &trans  &trans          &trans          &trans           &to 0           &to 3         &trans      &trans        &trans       &to 0          &trans
            >;
        };

        Navigation_Layer {
            bindings = <
        &none         &none   &none   &none   &none       &none   &none   &none   &none   &none
&trans  &bt BT_SEL 2  &trans  &trans  &trans  &bt BT_CLR  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 1  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans
        &bt BT_SEL 0  &trans  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans  &trans  &trans  &to 0       &to 4   &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
