#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>

// Muss laut ZMK-Doku VOR dem Include von pointing.h stehen
#define ZMK_POINTING_DEFAULT_MOVE_VAL 1500  // default: 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20    // default: 10
#include <dt-bindings/zmk/pointing.h>

// ---------------------------------------------------------------
// Ebenen
//   0 Basis
//   1 Symbole        rechter mittlerer Daumen: halten = Ebene, tippen = nächste Taste aus Symbolen
//   2 Zahlen + F     rechter äußerer Daumen:   halten = Ebene, tippen = sperren (nochmal tippen = zurück)
//   3 Navigation     linker mittlerer Daumen:  halten (tippen = Enter), alternativ ESC-Pinky halten
//   4 Maus           linker äußerer Daumen:    halten (tippen = Tab)
//   5 System / BT    Enter + Symbole gleichzeitig halten
//
// Rechter innerer Daumen = Shift: tippen = Sticky-Shift, halten = Shift, 2x tippen = Caps Word
//
// Deutsches OS-Layout: Strg+Z (Rückgängig) = LC(Y), Strg+Y (Wiederholen) = LC(Z)
// ---------------------------------------------------------------

// Tastenpositionen
#define KEYS_L   0 1 2 3 4 10 11 12 13 14 15 22 23 24 25 26 27 34 35 36 37 38
#define KEYS_R   5 6 7 8 9 16 17 18 19 20 21 28 29 30 31 32 33 39 40 41 42 43
#define THUMBS_L 44 45 46 47 48 49
#define THUMBS_R 50 51 52 53 54 55

// Timing
#define HRM_TAPPING_TERM 280
#define HRM_QUICK_TAP    175
#define HRM_PRIOR_IDLE   150
#define COMBO_PRIOR_IDLE 150

// Caps Word: Unterstrich (deutsches Layout = Shift + "-"-Taste) beendet es nicht
&caps_word {
    continue-list = <LS(SLASH) BACKSPACE DELETE>;
};

// Sticky-Shift löst beim nächsten Tastendruck aus, nicht erst beim Loslassen (verhindert "DEr")
&sk {
    quick-release;
};

// Maus: langsamer Start für präzise Bewegungen, beschleunigt bis zur Höchstgeschwindigkeit
&mmv {
    time-to-max-speed-ms = <600>;
    acceleration-exponent = <2>;
};

/ {
    macros {
        // Tottasten des deutschen Layouts direkt ausgeben (Tottaste + Leerzeichen)
        caret: caret {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp GRAVE &kp SPACE>;
        };

        backtick: backtick {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LS(EQUAL) &kp SPACE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        // Symbole (1) + Navigation (3) -> System (5)
        system_layer {
            if-layers = <1 3>;
            then-layer = <5>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // Space + Shift + Symbole (alle drei inneren Daumen)
        boot {
            bindings = <&bootloader>;
            key-positions = <49 50 51>;
        };

        BT0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <2 3>;
        };

        Backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <35 36>;
            layers = <0>;
        };

        Entf {
            bindings = <&kp DELETE>;
            key-positions = <12 13>;
            layers = <0>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        sz_combi {
            bindings = <&kp MINUS>;
            key-positions = <19 20>;
            layers = <0>;
        };

        EnterCombi {
            bindings = <&kp ENTER>;
            key-positions = <41 42>;
            layers = <0>;
        };

        copy {
            bindings = <&kp LC(C)>;
            key-positions = <14 15>;
            layers = <0>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        paste {
            bindings = <&kp LC(V)>;
            key-positions = <26 27>;
            layers = <0>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };

        cut {
            bindings = <&kp LC(X)>;
            key-positions = <37 38>;
            layers = <0>;
            require-prior-idle-ms = <COMBO_PRIOR_IDLE>;
        };
    };

    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM>;
            quick-tap-ms = <HRM_QUICK_TAP>;
            require-prior-idle-ms = <HRM_PRIOR_IDLE>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_R THUMBS_L THUMBS_R>;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM>;
            quick-tap-ms = <HRM_QUICK_TAP>;
            require-prior-idle-ms = <HRM_PRIOR_IDLE>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_L THUMBS_L THUMBS_R>;
        };

        // ESC-Pinky: Halten = Navigation (nur für Pfeile mit der rechten Hand)
        hml_mo_lay: hml_mo_lay {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <HRM_TAPPING_TERM>;
            quick-tap-ms = <HRM_QUICK_TAP>;
            require-prior-idle-ms = <HRM_PRIOR_IDLE>;
            hold-trigger-on-release;
            hold-trigger-key-positions = <KEYS_R THUMBS_R>;
        };

        // Halten = Ebene, Tippen = Taste (Tab, Enter)
        Tap_Layer: Tap_Layer {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&kp>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
        };

        // Halten = Ebene, Tippen = nur die nächste Taste aus der Ebene (Aufruf: &lt_sl 1 1)
        lt_sl: lt_sl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&sl>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        // Halten = Ebene, Tippen = Ebene sperren (Aufruf: &lt_lock 2 2)
        lt_lock: lt_lock {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&mo>, <&to>;
            flavor = "balanced";
            tapping-term-ms = <200>;
        };

        // Daumen-Shift: tippen = Sticky-Shift, halten = Shift,
        // tippen während Shift aktiv (also 2x tippen) = Caps Word. Ohne Tap-Dance-Verzögerung.
        smart_shift: smart_shift {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&sk LSHIFT>, <&caps_word>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        TopRightDance: TopRightDance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&bt BT_SEL 0>, <&bt BT_SEL 1>;
        };

        // 1x: Desktop rechts, 2x: Desktop links
        windows_desktop_tap_dance: windows_desktop_tap_dance {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            bindings = <&kp LG(LC(RIGHT))>, <&kp LG(LC(LEFT))>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // ---------------------------------------------------------- 0
        default_layer {
            display-name = "Basis";
            bindings = <
                   &none                       &none            &none                &none               &none      &none            &none                &none                 &none             &none
&none              &kp X                       &kp V            &kp L                &kp C               &kp W      &kp K            &kp H                &kp G                 &kp F             &kp Q             &none
&hml_mo_lay 3 ESC  &hml LEFT_GUI U             &hml LEFT_ALT I  &hml LEFT_CONTROL A  &hml LEFT_SHIFT E   &kp O      &kp S            &hmr RIGHT_SHIFT N   &hmr RIGHT_CONTROL R  &hmr RIGHT_ALT T  &hmr RIGHT_GUI D  &kp Z
                   &kp LEFT_BRACKET            &kp SEMICOLON    &kp SINGLE_QUOTE     &kp P               &kp Y      &kp B            &kp M                &kp COMMA             &kp PERIOD        &kp J
&kp PRINTSCREEN    &windows_desktop_tap_dance  &none            &Tap_Layer 4 TAB     &Tap_Layer 3 ENTER  &kp SPACE  &smart_shift     &lt_sl 1 1           &lt_lock 2 2          &none             &kp LG(L)         &TopRightDance
            >;
        };

        // ---------------------------------------------------------- 1
        symbol_layer {
            display-name = "Symbole";
            bindings = <
            &none              &none          &none         &none         &none          &none             &none              &none         &none         &none
&none       &kp RA(E)          &kp LS(SLASH)  &kp RA(N8)    &kp RA(N9)    &caret         &kp LS(NUMBER_1)  &kp NUBS           &kp LS(NUBS)  &kp LS(N0)    &kp LS(N6)     &none
&kp DELETE  &kp RA(MINUS)      &kp LS(N7)     &kp RA(N7)    &kp RA(N0)    &kp RS(RBRC)   &kp LS(MINUS)     &kp LS(N8)         &kp LS(N9)    &kp SLASH     &kp LS(DOT)    &kp RA(Q)
            &kp NUHS           &kp LS(N4)     &kp RA(NUBS)  &kp RA(RBRC)  &backtick      &kp LS(N5)        &kp RIGHT_BRACKET  &kp LS(N2)    &kp LS(NUHS)  &kp LS(COMMA)
&trans      &trans             &none          &trans        &trans        &trans         &trans            &trans             &trans        &none         &trans         &trans
            >;
        };

        // ---------------------------------------------------------- 2
        // Links: F-Tasten (gespiegelt zum Ziffernblock) + Modifier in der inneren Spalte
        // Rechts: Ziffernblock mit Rechenzeichen
        // Daumen rechts: Backspace, Entf, zurück zur Basis
        number {
            display-name = "Zahlen";
            bindings = <
            &none       &none       &none       &none       &none          &none         &none         &none         &none         &none
&none       &kp F12     &kp F7      &kp F8      &kp F9      &kp LCTRL      &kp LS(N7)    &kp N7        &kp N8        &kp N9        &kp LS(RBRC)  &none
&kp LGUI    &kp F11     &kp F4      &kp F5      &kp F6      &kp LSHIFT     &kp DOT       &kp N4        &kp N5        &kp N6        &kp RBRC      &kp COMMA
            &kp F10     &kp F1      &kp F2      &kp F3      &kp LALT       &kp N0        &kp N1        &kp N2        &kp N3        &kp SLASH
&trans      &to 0       &none       &trans      &trans      &trans         &kp BACKSPACE &kp DELETE    &to 0         &none         &to 0         &trans
            >;
        };

        // ---------------------------------------------------------- 3
        // Links: Media, Modifier, Bearbeiten · Rechts: Pfeile, Pos1/Ende/Bild, Browser-/IDE-Navigation
        nav_layer {
            display-name = "Navigation";
            bindings = <
            &none         &none         &none         &none         &none          &none         &none          &none             &none         &none
&none       &kp C_MUTE    &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_VOL_UP   &kp LC(F)     &kp HOME       &kp PG_UP         &kp PG_DN     &kp END       &none
&trans      &kp LGUI      &kp LALT      &kp LCTRL     &kp LSHIFT    &kp C_VOL_DN   &kp LC(A)     &kp LEFT       &kp UP            &kp DOWN      &kp RIGHT     &kp LG(V)
            &kp LC(Y)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(Z)      &kp LC(S)     &kp LA(LEFT)   &kp LC(LS(TAB))   &kp LC(TAB)   &kp LA(RIGHT)
&trans      &to 0         &none         &trans        &trans        &trans         &trans        &trans         &trans            &none         &to 0         &trans
            >;
        };

        // ---------------------------------------------------------- 4
        // Gehalten mit dem linken äußeren Daumen.
        // Rechts: Bewegung wie die Pfeile, Scrollen darüber, Zurück/Tabs/Vor darunter, Klicks auf den rechten Daumen
        // Links: wie Navigation (Media, Modifier für Strg-/Shift-Klick, Bearbeiten)
        mouse_layer {
            display-name = "Maus";
            bindings = <
            &none         &none         &none         &none         &none          &none         &none            &none             &none            &none
&none       &kp C_MUTE    &kp C_PREV    &kp C_PP      &kp C_NEXT    &kp C_VOL_UP   &none         &msc SCRL_LEFT   &msc SCRL_UP      &msc SCRL_DOWN   &msc SCRL_RIGHT  &none
&trans      &kp LGUI      &kp LALT      &kp LCTRL     &kp LSHIFT    &kp C_VOL_DN   &none         &mmv MOVE_LEFT   &mmv MOVE_UP      &mmv MOVE_DOWN   &mmv MOVE_RIGHT  &to 3
            &kp LC(Y)     &kp LC(X)     &kp LC(C)     &kp LC(V)     &kp LC(Z)      &none         &mkp MB4         &kp LC(LS(TAB))   &kp LC(TAB)      &mkp MB5
&trans      &to 0         &none         &trans        &trans        &trans         &mkp LCLK     &mkp RCLK        &mkp MCLK         &none            &to 0            &trans
            >;
        };

        // ---------------------------------------------------------- 5
        // Erreichbar über Enter + Symbole gleichzeitig halten
        system_layer {
            display-name = "System";
            bindings = <
            &none          &none          &none          &none          &none          &none   &none   &none   &none        &none
&none       &none          &none          &none          &none          &none          &none   &none   &none   &sys_reset   &bootloader  &none
&none       &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4   &none   &to 2   &to 4   &none        &none        &none
            &bt BT_CLR     &none          &out OUT_USB   &out OUT_BLE   &none          &none   &none   &none   &none        &none
&trans      &trans         &none          &trans         &trans         &trans         &trans  &trans  &trans  &none        &trans       &trans
            >;
        };
    };
};
