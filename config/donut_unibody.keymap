#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        boot {
            bindings = <&bootloader>;
            key-positions = <51 50 49>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
       &kp NUMBER_1  &kp A  &kp A   &kp A  &kp L  &kp V  &kp A  &kp A  &kp A  &kp N5
&kp A  &kp NUMBER_2  &kp A  &kp A   &kp A  &kp K  &kp C  &kp A  &kp A  &kp A  &kp NUMBER_6  &kp A
&kp A  &kp NUMBER_3  &kp A  &kp A   &kp A  &kp J  &kp D  &kp G  &kp X  &kp A  &kp A         &kp A
       &kp R         &kp T  &kp Z   &kp U  &kp I  &kp A  &kp H  &kp S  &kp F  &kp Y
&kp A  &kp A         &kp A  &kp N8  &kp Q  &kp W  &kp E  &kp R  &kp T  &kp Z  &kp U         &kp I
            >;
        };
    };
};
